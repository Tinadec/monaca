# Monaca runtime configuration — development defaults.
#
# Every variable the server, gateway, console, auth-ui and the dev scripts read is listed
# here (contract: docs/contracts/m0.md §2). Copy to `.env.local` (git-ignored) to override;
# Bun loads `.env`, `.env.local`, `.env.<NODE_ENV>`, `.env.<NODE_ENV>.local`, later wins.
# Every variable Monaca reads is prefixed MONACA_ (DATABASE_URL and VITE_* excepted).
#
# Values marked DEV-ONLY are public, fake, and must never be used outside a laptop or CI.

# --- server -----------------------------------------------------------------
# Bind address of monaca-server. In dev the server is NOT the public origin: the gateway
# proxies to it (MONACA_DEV_PROXY=1), so browsers and agents only ever see :8080.
MONACA_SERVER_ADDR=127.0.0.1:8081
# How the gateway and scripts reach the server directly (internal hop, /internal/* lives here).
MONACA_SERVER_URL=http://127.0.0.1:8081
# The single public origin. Every issuer is {MONACA_PUBLIC_BASE_URL}/t/{tenant_slug}; all
# discovery metadata, token `iss`, token endpoint `aud` checks are built from this value.
MONACA_PUBLIC_BASE_URL=http://localhost:8080
# Hosted sign-in UI origin. /t/{tenant}/oauth2/authorize redirects the browser here.
MONACA_AUTH_UI_URL=http://localhost:5174

# --- storage -----------------------------------------------------------------
# Control-plane DB (clusters, tenants, platform admins).
MONACA_CONTROL_DATABASE_URL=postgres://monaca:monaca@127.0.0.1:54329/monaca_control
# Superuser-ish DSN (CREATEDB + CREATEROLE) used only by migrate/bootstrap/provisioning.
MONACA_ADMIN_DATABASE_URL=postgres://monaca:monaca@127.0.0.1:54329/postgres
# Login role all request-path connections use; it is GRANTed every org role (SET ROLE target).
MONACA_APP_DB_USER=monaca_app
# DEV-ONLY password for monaca_app; bootstrap creates the role with it.
MONACA_APP_DB_PASSWORD=monaca_app_dev
# Per-tenant pool LRU: max cached tenant pools, connections per pool, idle eviction.
MONACA_TENANT_POOL_CACHE=64
MONACA_TENANT_POOL_SIZE=5
MONACA_TENANT_POOL_IDLE_SECS=300
# Defence-in-depth SET LOCAL ROLE per org transaction. Keep 1; 0 is a documented escape hatch.
MONACA_ORG_ROLE_ENFORCEMENT=1

# --- secrets / crypto --------------------------------------------------------
# DEV-ONLY: fake, public key-encryption key (32 bytes = 64 hex chars). Wraps per-tenant DEKs
# in the local dev database only. Production leaves it unset and uses the KMS KeyProvider;
# the server refuses to start with this exact value unless MONACA_ENV=dev.
MONACA_DEV_KEK=6d6f6e6163612d6465762d6b656b2d6e6f742d612d7265616c2d7365637265
# dev | ci | prod. prod forbids MONACA_DEV_KEK and MONACA_DEV_PROXY.
MONACA_ENV=dev
# DEV-ONLY: shared secret for gateway → server /internal/* (header X-Monaca-Internal-Secret).
# M1 replaces it with mTLS.
MONACA_INTERNAL_SECRET=dev-internal-secret-change-me
# Token lifetimes (seconds). Agent-delegated tokens are fixed at 300 by contract, not configurable.
MONACA_ACCESS_TOKEN_TTL_SECS=900
MONACA_REFRESH_TOKEN_TTL_SECS=2592000
MONACA_AUTH_CODE_TTL_SECS=60
MONACA_ID_TOKEN_TTL_SECS=900
MONACA_INTERACTION_TTL_SECS=600
# Accepted clock skew when verifying JWTs (server and napi Verifier default).
MONACA_CLOCK_SKEW_SECS=60
# Argon2id (memory KiB, iterations, parallelism) and the concurrent-hash cap.
MONACA_ARGON2_MEMORY_KIB=19456
MONACA_ARGON2_ITERATIONS=2
MONACA_ARGON2_PARALLELISM=1
MONACA_ARGON2_MAX_CONCURRENCY=4

# --- bootstrap seed (monaca-server bootstrap) ---------------------------------
# DEV-ONLY credentials for the seeded admin account in tenant "demo" (console login).
MONACA_BOOTSTRAP_ADMIN_EMAIL=admin@demo.localhost
MONACA_BOOTSTRAP_ADMIN_PASSWORD=monaca-dev-password
# DEV-ONLY secret of the seeded confidential client "monaca-admin" in tenant "demo"
# (client_credentials → scope monaca:admin). Used by scripts/e2e/skeleton.ts.
MONACA_BOOTSTRAP_ADMIN_CLIENT_SECRET=dev-admin-client-secret
# DEV-ONLY secret of the seeded console client "monaca-console" (BFF, client_secret_basic).
MONACA_CONSOLE_CLIENT_SECRET=dev-console-client-secret

# --- gateway / BFF -----------------------------------------------------------
MONACA_GATEWAY_ADDR=127.0.0.1:8080
# 1 = gateway forwards the server prefixes (/t/, /.well-known/, /v1/) to MONACA_SERVER_URL,
# making :8080 the single dev origin. 0 = edge routing is someone else's job (prod, M1).
MONACA_DEV_PROXY=1
# Tenant the console signs in to and administers in M0.
MONACA_CONSOLE_TENANT=demo
# Org the BFF resolves the signed-in user's membership in (§6.2 has no "my orgs" endpoint).
MONACA_BFF_DEFAULT_ORG=acme
MONACA_CONSOLE_CLIENT_ID=monaca-console
# Where the console is served; the BFF redirects here after login.
MONACA_CONSOLE_URL=http://localhost:5173
# Registered redirect URI; Vite proxies /bff/* to the gateway so the cookie lands on localhost.
MONACA_CONSOLE_REDIRECT_URI=http://localhost:5173/bff/callback
# monaca_session on http://localhost; set __Host-monaca_session (Secure) behind https.
MONACA_SESSION_COOKIE_NAME=monaca_session
MONACA_SESSION_TTL_SECS=28800
# How often the gateway re-pulls tenant JWKS into the napi Verifier.
MONACA_JWKS_REFRESH_SECS=300

# --- MCP demo resource server ------------------------------------------------
# Mount path inside the gateway and the RFC 8707/9728 resource identifier (token `aud`).
MONACA_MCP_DEMO_MOUNT=/mcp/demo
MONACA_MCP_DEMO_RESOURCE=http://localhost:8080/mcp/demo
# Tenant whose issuer the demo resource trusts.
MONACA_MCP_DEMO_TENANT=demo
# Org slug the demo's tool-call audit events are written under (gateway audit sink, §6.3).
MONACA_MCP_DEMO_ORG=acme

# --- frontend (Vite; only VITE_* reach browser code) ------------------------
MONACA_CONSOLE_PORT=5173
MONACA_AUTH_UI_PORT=5174
# Target of the Vite dev proxy (/bff, /t, /.well-known, /mcp). Mode B points this remote.
VITE_MONACA_GATEWAY_URL=http://localhost:8080

# --- dev modes (docs/contracts/m0.md §3) --------------------------------------
# a = local full stack, b = remote dev, c = ci only. Overrides .monaca/dev.json.
#MONACA_DEV_MODE=a
# Mode B: the deployed dev gateway (single public origin of the remote environment).
MONACA_REMOTE_URL=https://dev.monaca.example
# Mode A: reuse an existing PG (role needs CREATEDB + CREATEROLE). Unset = embedded PG.
#DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Embedded PG (mode A fallback): port, superuser, password. Data dir is .monaca/pg/data.
MONACA_EMBEDDED_PG_PORT=54329
MONACA_EMBEDDED_PG_USER=monaca
MONACA_EMBEDDED_PG_PASSWORD=monaca
# Path of the fetched server binary. Default: .monaca/bin/monaca-server(.exe).
#MONACA_SERVER_BIN=

# --- observability -----------------------------------------------------------
# Server: tracing EnvFilter syntax (e.g. info,monaca_store=debug). Bun: a plain level.
MONACA_LOG_LEVEL=info
# pretty | json
MONACA_LOG_FORMAT=pretty
# OTLP/HTTP endpoint; empty means no exporter.
MONACA_OTLP_ENDPOINT=
