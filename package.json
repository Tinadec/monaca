{
  "name": "monaca",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monaca — full-stack identity & access management for the AI-agent era",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "fetch:native": "bun scripts/fetch-native.ts",
    "verify:ci": "bun scripts/verify-ci.ts",
    "e2e:skeleton": "bun scripts/e2e/skeleton.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "test": "bun test --pass-with-no-tests",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@monaca/kernel": "workspace:*",
    "@monaca/mcp": "workspace:*",
    "@monaca/module-mcp-demo": "workspace:*",
    "@types/bun": "^1.4.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "jose": "^6.2.12",
    "typescript": "^6.0.3"
  }
}
