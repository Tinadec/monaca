{
  "name": "@monaca/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Monaca management API plus agent helpers",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --pass-with-no-tests",
    "generate": "openapi-typescript ../../spec/openapi.json -o src/schema.gen.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@monaca/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0"
  }
}
