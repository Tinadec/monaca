{
  "name": "@monaca/core",
  "version": "0.0.0",
  "private": true,
  "description": "In-process native verifier (napi-rs). Binaries are fetched from CI: bun run fetch:native",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "napi build --release --platform --no-js --dts index.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "monaca-core",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@monaca/tsconfig": "workspace:*",
    "@napi-rs/cli": "^3.10.8",
    "jose": "^6.2.12"
  }
}
