{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "index.d.ts",
    "test/**/*.ts"
  ]
}
